{
  "name": "mocha-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "chart.js": "^4.5.1",
    "hono": "4.13.13",
    "lucide-react": "^0.562.0",
    "react": "19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.0.0",
    "react-router": "^7.18.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "5.20260903.1",
    "@eslint/js": "^9.39.5",
    "@getmocha/users-service": "^0.0.4",
    "@getmocha/vite-plugins": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.14.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:verify-version": "bash wordpress-plugin/banimal-ecosystem-connector/bin/verify-version.sh",
    "plugin:build": "bash wordpress-plugin/banimal-ecosystem-connector/bin/build-zip.sh",
    "brand:render": "node scripts/render-canonical-docs.mjs --out .rendered-docs",
    "brand:verify": "node scripts/render-canonical-docs.mjs --out .brand-render && node scripts/verify-brand-alignment.mjs --rendered .brand-render",
    "brand:generate-palette": "python3 scripts/generate-palette-assets.py",
    "connector:build": "node scripts/build-connector.mjs"
  },
  "overrides": {
    "wrangler": "$wrangler",
    "miniflare": "^5.20261006.1-alpha",
    "undici": "^7.30.0",
    "sharp": "^0.35.5"
  }
}
