                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-sm text-gray-500&quot;&gt;$\text{R899.00} / 18.50$&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-lg font-semibold text-accent&quot;&gt;$48.60&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm text-gray-900&quot;&gt;R899.00&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-sm font-medium text-gray-700&quot;&gt;Retail Price (Excl VAT)&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-sm text-gray-500&quot;&gt;$\text{\$48.60} / 1.15$&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm text-gray-900&quot;&gt;$42.26&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm text-gray-500&quot;&gt;R781.74&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr&gt;
