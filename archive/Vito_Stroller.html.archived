                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm text-gray-900&quot;&gt;$21.13&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm text-gray-500&quot;&gt;R390.87&lt;/td&gt;
                        &lt;/tr&gt;
                        &lt;tr class=&quot;bg-gray-100&quot;&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-sm font-semibold text-gray-800&quot;&gt;Estimated Landed Cost (D)&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-sm text-gray-500&quot;&gt;Cost to Retailer Warehouse&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm font-semibold text-gray-800&quot;&gt;$21.13&lt;/td&gt;
                            &lt;td class=&quot;px-3 py-4 whitespace-nowrap text-right text-sm font-semibold text-gray-800&quot;&gt;R390.87&lt;/td&gt;
